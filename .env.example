# Names only. Never put real values in this file; .env is git-ignored.
# The app has no runtime secrets. These are build-time values passed with
# `flutter run/build --dart-define=NAME=value` (or --dart-define-from-file=.env).

# Product id (docs/CONTRACTS.md in nextjedi/platform)
# value: life-mathematics
NEXTJEDI_PRODUCT=

# Crash reporting. Empty = Sentry is not initialised (no-op).
SENTRY_DSN=
# dev | prod
SENTRY_ENVIRONMENT=

# Analytics (not wired yet, NEX-1147)
POSTHOG_KEY=

# Signing / store upload: CI secrets only (Azure DevOps library today, GitHub secrets after NEX-1138).
# Listed so the names are documented; never set them here.
# KEYSTORE_PASSWORD=
# KEY_PASSWORD=
# KEY_ALIAS=
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# APPLE_TEAM_ID=
